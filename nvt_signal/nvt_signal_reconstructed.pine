//@version=6
//
// NVT Signal - reconstruction of the closed-source "NVT Signal" indicator
// NVTS = Market cap / SMA(daily on-chain transaction volume in USD, N chart bars)
//
// Same data feeds as aamonkey's "NVT Dynamic Colored with Signals".
// With N = 90 (aamonkey's default "MA Volume"), this line = 4 x aamonkey's nvt on every bar,
// because aamonkey divides the same ratio by 4.
//
// N = 90 is the classic value but is not confirmed for the original script.
// Check the original's Settings > Inputs (visible even for protected scripts) and set N to match.
//
indicator("NVT Signal (reconstructed)", shorttitle = "NVTS", overlay = false, precision = 2)

//Get the data (symbols are inputs so a replacement feed can be typed in if QUANDL stops working)
volSymbol = input.symbol("QUANDL:BCHAIN/ETRVU", "Tx volume (USD) symbol")
mcSymbol  = input.symbol("QUANDL:BCHAIN/MKTCP", "Market cap (USD) symbol")
transactionVolume = request.security(volSymbol, "D", close)
marketCap         = request.security(mcSymbol, "D", close)

//NVT Signal
maLen = input.int(90, "Transaction MA length (chart bars)", minval = 1)
nvts = marketCap / ta.sma(transactionVolume, maLen)

//Levels per timeframe class
// daily class   (1D..5D, timeframe.isdaily)   : 45 / 150
// weekly class  (1W, 2W.., timeframe.isweekly) : 100 / 450
// monthly class (1M, 3M.., timeframe.ismonthly): 333 / 1000
// intraday falls through to the daily levels (not observed on the original)
osD = input.float(45.0,   "Oversold - daily class",    group = "Levels")
obD = input.float(150.0,  "Overbought - daily class",  group = "Levels")
osW = input.float(100.0,  "Oversold - weekly class",   group = "Levels")
obW = input.float(450.0,  "Overbought - weekly class", group = "Levels")
osM = input.float(333.0,  "Oversold - monthly class",  group = "Levels")
obM = input.float(1000.0, "Overbought - monthly class", group = "Levels")

osLevel = timeframe.ismonthly ? osM : timeframe.isweekly ? osW : osD
obLevel = timeframe.ismonthly ? obM : timeframe.isweekly ? obW : obD

//Plot
// hline() only accepts a constant/input price, so timeframe-dependent levels are drawn with plot().
plot(obLevel, "Overbought", color = color.red,   linewidth = 1, style = plot.style_stepline)
plot(osLevel, "Oversold",   color = color.green, linewidth = 1, style = plot.style_stepline)
nvtsColor = nvts < osLevel ? color.green : nvts > obLevel ? color.red : color.black
plot(nvts, "NVTS", color = nvtsColor, linewidth = 2)

//Alerts
alertcondition(ta.crossunder(nvts, osLevel), "NVTS entered oversold",   "NVTS crossed below the oversold level")
alertcondition(ta.crossover(nvts, obLevel),  "NVTS entered overbought", "NVTS crossed above the overbought level")
