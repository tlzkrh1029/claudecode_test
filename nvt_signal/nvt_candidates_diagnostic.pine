//@version=6
//
// NVT candidates - diagnostic. Every candidate has its own title so each value appears in the Data Window.
// "Values" mode: compare the original indicator's value with C1..C9 on the same bar.
// "Ratios" mode: pick the original indicator's NVT line in "Original NVT line" (source dropdown).
//   R1 = 1.000 and R2 = 4.000 on every bar -> original = MC/sma(V, Base length), no /4.
//   R1 wobbling around 1 -> original uses a nearby length: move "Alternative length" (try 80-89, 95-100)
//   until R7 is flat at 1.000.
//
indicator("NVT candidates (diagnostic)", shorttitle = "NVT-diag", overlay = false, precision = 3)

volSym = input.symbol("QUANDL:BCHAIN/ETRVU", "Tx volume (USD) symbol")
mcSym  = input.symbol("QUANDL:BCHAIN/MKTCP", "Market cap (USD) symbol")
len    = input.int(90, "Base length", minval = 1)
lenAlt = input.int(80, "Alternative length (C7)", minval = 1)
orig   = input.source(close, "Original NVT line (select it here)")
mode   = input.string("Values", "Show", options = ["Values", "Ratios"])

vol = request.security(volSym, "D", close)
mc  = request.security(mcSym, "D", close)

c1 = mc / ta.sma(vol, len)                                  // classic NVTS, SMA over chart bars (main hypothesis)
c2 = c1 / 4                                                 // aamonkey DNVT_aam 'nvt'
c3 = mc / request.security(volSym, "D", ta.sma(close, len)) // SMA of len DAYS computed inside security (same on every timeframe)
c4 = mc / ta.rma(vol, len)                                  // RMA instead of SMA
c5 = mc / ta.ema(vol, len)                                  // EMA instead of SMA
c6 = ta.sma(mc / vol, len)                                  // SMA of the daily ratio
c7 = mc / ta.sma(vol, lenAlt)                               // nearby length
c8 = c1[1]                                                  // same formula, 1 bar later
c9 = mc / vol                                               // raw NVT (no smoothing)

showVals = mode == "Values"

plot(showVals ? c1 : na, "C1 MC/sma(V,len) chart bars", color = color.blue, linewidth = 2)
plot(showVals ? c2 : na, "C2 aamonkey C1/4", color = color.orange)
plot(showVals ? c3 : na, "C3 MC/sma(V,len days) in security", color = color.purple)
plot(showVals ? c4 : na, "C4 MC/rma(V,len)", color = color.teal)
plot(showVals ? c5 : na, "C5 MC/ema(V,len)", color = color.fuchsia)
plot(showVals ? c6 : na, "C6 sma(MC/V,len)", color = color.olive)
plot(showVals ? c7 : na, "C7 MC/sma(V,lenAlt)", color = color.maroon)
plot(showVals ? c8 : na, "C8 C1 lagged 1 bar", color = color.navy)
plot(showVals ? c9 : na, "C9 raw MC/V", color = color.new(color.gray, 70))

plot(showVals ? na : orig / c1, "R1 orig/C1 (expect 1)", color = color.blue, linewidth = 2)
plot(showVals ? na : orig / c2, "R2 orig/C2 (expect 4)", color = color.orange)
plot(showVals ? na : orig / c3, "R3 orig/C3", color = color.purple)
plot(showVals ? na : orig / c4, "R4 orig/C4", color = color.teal)
plot(showVals ? na : orig / c5, "R5 orig/C5", color = color.fuchsia)
plot(showVals ? na : orig / c6, "R6 orig/C6", color = color.olive)
plot(showVals ? na : orig / c7, "R7 orig/C7", color = color.maroon)
plot(showVals ? na : orig / c8, "R8 orig/C8", color = color.navy)
