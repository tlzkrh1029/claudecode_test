//@version=4
//
// NVT candidates - diagnostic. Every candidate has its own title so each value appears in the Data Window.
// "Values" mode: compare the original indicator's value with C1..C9 on the same bar.
// "Ratios" mode: pick the original indicator's NVT line in "Original NVT line" (source dropdown).
//   R1 = 1.000 and R2 = 4.000 on every bar -> original = MC/sma(V, Base length), no /4.
//   R1 wobbling around 1 -> original uses a nearby length: move "Alternative length" (try 80-89, 95-100)
//   until R7 is flat at 1.000.
//
study("NVT candidates (diagnostic)", shorttitle="NVT-diag", overlay=false, precision=3)

volSym = input("QUANDL:BCHAIN/ETRVU", title="Tx volume (USD) symbol", type=input.string)
mcSym = input("QUANDL:BCHAIN/MKTCP", title="Market cap (USD) symbol", type=input.string)
len = input(90, title="Base length", type=input.integer, minval=1)
lenAlt = input(80, title="Alternative length (C7)", type=input.integer, minval=1)
orig = input(close, title="Original NVT line (select it here)", type=input.source)
mode = input("Values", title="Show", type=input.string, options=["Values", "Ratios"])

vol = security(volSym, 'D', close[0])
mc = security(mcSym, 'D', close[0])

c1 = mc / sma(vol, len)                                // classic NVTS, SMA over chart bars (main hypothesis)
c2 = c1 / 4                                            // aamonkey DNVT_aam 'nvt'
c3 = mc / security(volSym, 'D', sma(close, len))       // SMA of len DAYS computed inside security (same on every timeframe)
c4 = mc / rma(vol, len)                                // RMA instead of SMA
c5 = mc / ema(vol, len)                                // EMA instead of SMA
c6 = sma(mc / vol, len)                                // SMA of the daily ratio
c7 = mc / sma(vol, lenAlt)                             // nearby length
c8 = c1[1]                                             // same formula, 1 bar later
c9 = mc / vol                                          // raw NVT (no smoothing)

showVals = mode == "Values"

plot(showVals ? c1 : na, title="C1 MC/sma(V,len) chart bars", color=color.blue, linewidth=2)
plot(showVals ? c2 : na, title="C2 aamonkey C1/4", color=color.orange)
plot(showVals ? c3 : na, title="C3 MC/sma(V,len days) in security", color=color.purple)
plot(showVals ? c4 : na, title="C4 MC/rma(V,len)", color=color.teal)
plot(showVals ? c5 : na, title="C5 MC/ema(V,len)", color=color.fuchsia)
plot(showVals ? c6 : na, title="C6 sma(MC/V,len)", color=color.olive)
plot(showVals ? c7 : na, title="C7 MC/sma(V,lenAlt)", color=color.maroon)
plot(showVals ? c8 : na, title="C8 C1 lagged 1 bar", color=color.navy)
plot(showVals ? c9 : na, title="C9 raw MC/V", color=color.gray, transp=70)

plot(showVals ? na : orig / c1, title="R1 orig/C1 (expect 1)", color=color.blue, linewidth=2)
plot(showVals ? na : orig / c2, title="R2 orig/C2 (expect 4)", color=color.orange)
plot(showVals ? na : orig / c3, title="R3 orig/C3", color=color.purple)
plot(showVals ? na : orig / c4, title="R4 orig/C4", color=color.teal)
plot(showVals ? na : orig / c5, title="R5 orig/C5", color=color.fuchsia)
plot(showVals ? na : orig / c6, title="R6 orig/C6", color=color.olive)
plot(showVals ? na : orig / c7, title="R7 orig/C7", color=color.maroon)
plot(showVals ? na : orig / c8, title="R8 orig/C8", color=color.navy)
